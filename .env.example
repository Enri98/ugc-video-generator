# Vertex AI — used for Gemini, Nano Banana 2, Veo 3.1 Fast
# Authenticated via the service account JSON below; no API key needed.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Path to the Google service account JSON. Used for both Vertex AI and Drive.
# The SA needs roles/aiplatform.user (Vertex) and Editor on the Drive folders.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# Google Drive (folder IDs from the Drive URL)
GOOGLE_DRIVE_INPUT_FOLDER_ID=
GOOGLE_DRIVE_OUTPUT_VIDEOS_FOLDER_ID=
GOOGLE_DRIVE_OUTPUT_REPORTS_FOLDER_ID=

# Operational
LOG_LEVEL=INFO
